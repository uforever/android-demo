<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13+ 动态权限：POST_NOTIFICATIONS -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 网络和Wi-Fi状态权限 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 拨打电话权限 -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Android 11+ 包可见性配置 -->
    <!-- 声明需要查询的应用类型，用于拨号功能 -->
    <queries>
        <!-- 查询支持 ACTION_DIAL 的应用（拨号应用） -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <!-- 查询支持 ACTION_CALL 的应用（通话应用） -->
        <intent>
            <action android:name="android.intent.action.CALL" />
            <data android:scheme="tel" />
        </intent>
        <!-- 查询浏览器应用（备用方案） -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidComponentDemo">

        <!-- MainActivity：主界面，底部导航容器 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SecondActivity：用于演示显式Intent跳转 -->
        <activity
            android:name=".SecondActivity"
            android:exported="false"
            android:label="SecondActivity" />

        <!-- 后台服务：每5秒打印一次Log -->
        <service
            android:name=".BackgroundService"
            android:exported="false" />

        <!-- 前台服务：带有常驻通知 -->
        <service
            android:name=".ForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 内容提供者：提供图书数据访问 -->
        <provider
            android:name=".BookProvider"
            android:authorities="com.example.demo.provider"
            android:exported="false" />

    </application>

</manifest>
